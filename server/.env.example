# Скопіюйте у .env і заповніть (або задайте змінні оточення іншим способом)
MDS_DATA_DIR=./data
# MDS_DATABASE_URL=postgresql+psycopg://mds:password@localhost/mds   # за замовчуванням SQLite у data/
MDS_TELEGRAM_TOKEN=            # токен від @BotFather
MDS_TIMEZONE=Europe/Kyiv
MDS_PORT=8000
MDS_TOKEN_TTL_HOURS=12
MDS_BACKUP_INTERVAL_HOURS=24
MDS_BACKUP_KEEP=30
# MDS_SECRET_KEY=              # якщо не задано — генерується й зберігається в data/secret.key

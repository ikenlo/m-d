# MDS Connect — змінні середовища (скопіюйте в .env або задайте в Railway → Variables).
# Секрети (токени, ключі, паролі) — ЛИШЕ тут або в змінних хостингу, ніколи в коді й чатах.

# Середовище: production (за замовчуванням) або test. У production заборонені очищення й демо-дані.
MDS_ENV=production

# Дані й база
MDS_DATA_DIR=./data
# MDS_DATABASE_URL=sqlite:///./data/mds.db
MDS_TIMEZONE=Europe/Kyiv

# Сесії: підпис JWT (довгий випадковий рядок), абсолютний строк і автовихід через бездіяльність
MDS_SECRET_KEY=
MDS_TOKEN_TTL_HOURS=12
MDS_IDLE_MINUTES=30

# Перший директор (лише для першого запуску; пароль після входу видалити)
MDS_DIRECTOR_USERNAME=
MDS_DIRECTOR_PASSWORD=
MDS_DIRECTOR_NAME=

# Telegram-бот
MDS_TELEGRAM_TOKEN=

# Резервні копії
MDS_BACKUP_INTERVAL_HOURS=6
MDS_BACKUP_KEEP_DAYS=30
# Google Drive: Service Account (рекомендовано) або OAuth-клієнт
MDS_GDRIVE_SA_JSON=
MDS_GDRIVE_FOLDER_ID=
MDS_GDRIVE_CLIENT_ID=
MDS_GDRIVE_CLIENT_SECRET=
# Ключ шифрування копій перед завантаженням (base64, 32 байти): python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MDS_BACKUP_ENCRYPTION_KEY=

# MDs Manager (лише читання /api/ext/v1)
# Порожньо — /api/ext/v1 вимкнено (404). Довгий випадковий рядок, напр. `python -c "import secrets;print(secrets.token_urlsafe(32))"`
MDS_MANAGER_API_KEY=

# Вебхуки Meta (Instagram/Facebook/WhatsApp) → черга для MDs Manager (канон D-5, D-6a)
# Токен перевірки підписки (довільний рядок, той самий, що в налаштуваннях вебхука Meta)
MDS_META_VERIFY_TOKEN=
# App Secret застосунку Meta — перевірка підпису X-Hub-Signature-256
MDS_META_APP_SECRET=
# Через скільки хвилин запис у статусі «processing» вважається завислим і повертається в чергу
MDS_WEBHOOK_PROCESSING_TIMEOUT_MINUTES=5

# AI-рекомендації: rules (за замовчуванням) або llama (локальний llama.cpp)
MDS_AI_PROVIDER=rules
MDS_AI_LLAMA_URL=http://localhost:8080/v1

# Аварійно вимкнути двофакторний вхід (тимчасово)
# MDS_TWOFA_DISABLED=1

# «Термінал» ПриватБанку — автоматичні оплати з версії 0.4.0
# MDS_PRIVAT_TERMINAL_CLID=
# MDS_PRIVAT_TERMINAL_SECRET=
# MDS_PRIVAT_TERMINAL_CLIENT_TOKEN=
